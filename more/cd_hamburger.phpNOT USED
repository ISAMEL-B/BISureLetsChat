<?php

// Ensure the user is logged in
if (!isset($_SESSION['user_id']) || strlen($_SESSION['user_id']) == 0) {
    header('Location: ../register/register.php');
    exit();
}

// Include database connection
include '../register/config/db.php';

$office_id = $_SESSION['user_id'] ?? null;
if (!$office_id) {
    die("Access denied: No user session found.");
}

// Fetch user info from DB
$retrieve_stmt = $conn->prepare("SELECT profile_picture, fname, email, phone_number, date_created, username FROM offices WHERE office_id = ?");
$retrieve_stmt->bind_param("i", $office_id);
$retrieve_stmt->execute();
$retrieved_result_set = $retrieve_stmt->get_result();
$office_user_data = $retrieved_result_set->fetch_assoc();
$retrieve_stmt->close();

$default_picture = '../sharing/chat/user.png';
$profile_picture = $office_user_data['profile_picture'] ?? '';

// Server path to validate file existence
$server_path = '../sharing/chat/' . $profile_picture;

// Web path to load in `<img src="">`
$web_path = '../sharing/chat/' . $profile_picture;

$picture_path = (!empty($profile_picture) && file_exists($server_path))
    ? htmlspecialchars($web_path)
    : $default_picture;

?>

