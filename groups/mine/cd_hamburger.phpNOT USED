<?php

$office_id = $_SESSION['user_id'] ?? null; // Ensure it's set

if (!$office_id) {
    die("Access denied: No user session found.");
}

// Fetch user info from DB
$retrieve_stmt = $conn->prepare("SELECT profile_picture, fname, email, phone_number, date_created, username FROM offices WHERE office_id = ?");
$retrieve_stmt->bind_param("i", $office_id);
$retrieve_stmt->execute();
$retrieved_result_set = $retrieve_stmt->get_result();
$office_user_data = $retrieved_result_set->fetch_assoc();
$retrieve_stmt->close();

// Set profile picture with fallback
$profile_picture = $office_user_data['profile_picture'] ?? '';
$default_picture = 'user.png';
$picture_path = (!empty($profile_picture) && file_exists($profile_picture))
    ? htmlspecialchars($profile_picture)
    : $default_picture;
?>

